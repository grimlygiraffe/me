---
import SocialList from "@/components/SocialList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import EditorialPreview from "@/components/blog/EditorialPreview.astro";
import EditorialPreview from "@/components/blog/blogPreview.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();

const paperPosts = allPosts.filter(post => post.data.category === "paper");
const editorialPosts = allPosts.filter(post => post.data.category === "editorial");
const blogPosts = allPosts.filter(post => post.data.category === "blog");

const paperPostsByDate = sortMDByDate(paperPosts).slice(0, MAX_POSTS);
const editorialPostsByDate = sortMDByDate(editorialPosts).slice(0, MAX_POSTS);
const blogPostsByDate = sortMDByDate(blogPosts).slice(0, MAX_POSTS);

const cactusTech: { desc: string; title: string }[] = [
	{
		desc: "Shows that a zetetic view of democracy solves a tension between requirements to suspend political belief and core democratic commitments.",
		title: "#1",
	},
	{
		desc: "Argues that even when acting reasonably and in good faith, citizens can be anti-democratic if they violate zetetic norms of political decision-making",
		title: "#2",
	},
	{
		desc: "Do parasocial relationships with politicians threaten democracy? We contend that not always. Actually, they can even improve political legitimacy.",
		title: "#3",
	},	
	{
		desc: "Argues for a zetetic account of democracy, showing it to be an improvement over arguments that emphasise either the epistemic or moral benefits of democracy.",
		title: "#4",
	},
		{
		desc: "Discusses the merits and shortcomings of extant formulations of the claim that norms for belief suspension can conflict with democratic principles and duties.",
		title: "#5",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<p class="mb-4">
Assistant Professor of Philosophy at Tilburg University and Humboldt Fellow at the University of Cologne. Most of my current research looks at how the epistemology of inquiry can inform normative democratic theory, but I occasionally delve into topics in philosophy of mind. I have also worked extensively on the norms of philosophical inquiry.
</p>
		<SocialList />
	</section>
<section aria-label="Papers list" class="mt-16">
  <h2 class="title mb-4 text-xl">Papers</h2>
  <ul class="space-y-4">
    {
      paperPostsByDate.map((p) => (
        <li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
          <PostPreview post={p} />
        </li>
      ))
    }
  </ul>
</section>

<!-- Editorial section -->
<section aria-label="Editorial work" class="mt-16">
  <h2 class="title mb-4 text-xl">Editorial work</h2>
  <ul class="space-y-4">
    {
      editorialPostsByDate.map((p) => (
        <li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
          <PostPreview post={p} />
        </li>
      ))
    }
  </ul>
</section>

<!-- Blog section -->
<section aria-label="Blogposts" class="mt-16">
  <h2 class="title mb-4 text-xl">Other writings</h2>
  <ul class="space-y-4">
    {
      blogPostsByDate.map((p) => (
        <li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
          <PostPreview post={p} />
        </li>
      ))
    }
  </ul>
</section>

<section class="mt-16">
		<dl class="space-y-4">
		<h2 class="title mb-4 text-xl">Work in Progress</h2>
			{
				cactusTech.map(({ desc, href, title }) => (
					<div class="flex flex-col gap-2 sm:flex-row">
						<dt>
							<span class="flex">
								<a class="cactus-link" href={href} rel="noreferrer" target="_blank">
									{title}
								</a>
								:
							</span>
						</dt>
						<dd>{desc}</dd>
					</div>
				))
			}
		</dl>
	</section>
</PageLayout>
